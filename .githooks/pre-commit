#!/bin/sh
# Runs before every commit and stops it if it contains API keys, CVs or other
# personal data. Turned on with: git config core.hooksPath .githooks

cd "$(git rev-parse --show-toplevel)" || exit 1

if command -v uv >/dev/null 2>&1; then
  exec uv run --no-project --quiet python tools/check_no_secrets.py --staged
fi
for python in python3 python; do
  if command -v "$python" >/dev/null 2>&1; then
    exec "$python" tools/check_no_secrets.py --staged
  fi
done

echo "Jobcu safety check: Python wasn't found, so the commit was stopped to be safe."
exit 1
